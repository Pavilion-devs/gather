{
  "name": "gather",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "vite build",
    "backend": "convex dev --local-cloud-port 3216 --local-site-port 3217",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --env-file=.env.local tests/integration.mjs",
    "typecheck": "tsc --project convex/tsconfig.json",
    "test:mail": "vitest run",
    "eval:sources": "node --env-file=.env.local scripts/evaluate-sources.mjs",
    "build:hosted": "node scripts/build-hosted.mjs",
    "deploy:backend": "convex deploy --env-file .env.cloud",
    "test:accounts": "vitest run tests/accounts.convex.test.ts",
    "deploy": "node scripts/deploy-site.mjs"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/static-hosting": "^0.2.1",
    "@fontsource/inter": "^5.2.8",
    "better-auth": "1.6.22",
    "convex": "1.46.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-react": "^4.7.0",
    "convex-test": "^0.0.59",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "4.1.11"
  }
}
